---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'beyondProjects'>;
  section: string;
}

const { project, section } = Astro.props;
const { data } = project;
---

<article class="project-card">
  {data.featuredImage && (
    <img src={data.featuredImage.src} alt={data.featuredImage.alt} loading="lazy" decoding="async" />
  )}
  <div class="project-copy">
    <p class="eyebrow">{data.category}{data.date && ` / ${data.date.getFullYear()}`}</p>
    <h3><a href={`/beyond/${section}/${project.id}/`}>{data.title}</a></h3>
    <p>{data.description}</p>
    <a class="project-link" href={`/beyond/${section}/${project.id}/`}>View project <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .project-card{display:grid;grid-template-columns:minmax(140px,.5fr) 1fr;gap:1.25rem;border:1px solid var(--line);background:var(--paper)}
  .project-card>img{width:100%;height:100%;min-height:180px;object-fit:cover}
  .project-copy{padding:1.25rem}
  .eyebrow{margin:0 0 .5rem}
  h3{margin:0;font-family:var(--serif);font-size:1.4rem;font-weight:500}
  h3 a{color:var(--ink);text-decoration:none}
  h3 a:hover{text-decoration:underline;text-decoration-color:var(--bronze)}
  .project-copy>p:not(.eyebrow){margin:.6rem 0;color:var(--ink-soft);font-size:.9rem}
  .project-link{font-size:.82rem;font-weight:750;text-decoration:none}
  @media(max-width:560px){.project-card{grid-template-columns:1fr}.project-card>img{max-height:250px}}
</style>
