---
interface Photo {
  src: string;
  title: string;
  alt: string;
  caption: string;
  category: string;
  location?: string;
  orientation?: 'wide' | 'tall' | 'square';
}

const { photos = [] } = Astro.props as { photos: Photo[] };
---

<div class="photo-grid" data-photo-grid>
  {photos.map((photo, index) => (
    <figure class:list={['photo-card', `photo-card--${photo.orientation ?? 'wide'}`]} data-category={photo.category}>
      <button type="button" data-photo-index={index} aria-label={`View ${photo.title} full screen`}>
        <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
      </button>
      <figcaption>
        <strong>{photo.title}</strong>
        <span>{photo.caption}</span>
        <small>{photo.category}{photo.location ? ` / ${photo.location}` : ''}</small>
      </figcaption>
    </figure>
  ))}
</div>

<style>
  .photo-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:1.1rem}
  .photo-card{grid-column:span 6;margin:0;border:1px solid var(--line);background:var(--paper-raised)}
  .photo-card--wide{grid-column:span 8}
  .photo-card--tall{grid-column:span 4}
  .photo-card--square{grid-column:span 4}
  .photo-card button{width:100%;padding:0;border:0;background:none;cursor:zoom-in}
  .photo-card img{width:100%;height:420px;object-fit:cover}
  .photo-card--wide img{height:360px}
  .photo-card--tall img{height:560px}
  .photo-card--square img{height:360px}
  .photo-card figcaption{display:flex;min-height:132px;flex-direction:column;gap:.35rem;padding:1rem}
  .photo-card figcaption strong{font-family:var(--serif);font-size:1.15rem;font-weight:500}
  .photo-card figcaption span,.photo-card figcaption small{color:var(--ink-soft)}
  .photo-card figcaption small{margin-top:auto;font-size:.68rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase}
  @media(max-width:900px){.photo-card,.photo-card--wide,.photo-card--tall,.photo-card--square{grid-column:span 6}.photo-card img,.photo-card--wide img,.photo-card--tall img,.photo-card--square img{height:360px}}
  @media(max-width:640px){.photo-grid{grid-template-columns:1fr}.photo-card,.photo-card--wide,.photo-card--tall,.photo-card--square{grid-column:1}.photo-card img,.photo-card--wide img,.photo-card--tall img,.photo-card--square img{height:auto;max-height:520px}}
</style>
