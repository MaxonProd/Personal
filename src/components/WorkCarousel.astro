---
import WorkCard from './WorkCard.astro';
interface Work { id:string; data:{title:string;description:string;summary?:string;category:string;date?:Date;image?:string;organization?:string;featured?:boolean}; }
const {items}=Astro.props as {items:Work[]};
---
<div class="carousel" aria-label="Featured work"><div class="controls"><button type="button" data-prev aria-label="Previous featured work">←</button><span aria-live="polite" data-status>1 of {items.length}</span><button type="button" data-next aria-label="Next featured work">→</button></div><div class="track" data-track tabindex="0">{items.map((item)=><WorkCard slug={item.id} {...item.data}/>)}</div></div>
<script>document.querySelectorAll('.carousel').forEach((carousel)=>{const track=carousel.querySelector('[data-track]') as HTMLElement|null;const cards=track?.children;const status=carousel.querySelector('[data-status]');const move=(direction:number)=>{if(!track||!cards?.length)return;track.scrollBy({left:direction*(cards[0] as HTMLElement).offsetWidth+24,behavior:'smooth'})};carousel.querySelector('[data-prev]')?.addEventListener('click',()=>move(-1));carousel.querySelector('[data-next]')?.addEventListener('click',()=>move(1));track?.addEventListener('scroll',()=>{if(!cards?.length||!status)return;const width=(cards[0] as HTMLElement).offsetWidth+24;const current=Math.min(cards.length,Math.round(track.scrollLeft/width)+1);status.textContent=`${current} of ${cards.length}`},{passive:true})})</script>
<style>.controls{display:flex;align-items:center;justify-content:flex-end;gap:.8rem;margin-bottom:1rem}.controls button{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);background:transparent;cursor:pointer}.controls button:hover{color:var(--paper);background:var(--ink)}.controls span{min-width:4rem;color:var(--ink-soft);font-size:.78rem;text-align:center}.track{display:flex;gap:1.5rem;padding:0 0 1.5rem;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-color:var(--bronze) var(--paper-soft)}.track>*{scroll-snap-align:start}</style>
