---
interface Props { eyebrow?:string; title:string; description?:string; linkHref?:string; linkLabel?:string; }
const {eyebrow,title,description,linkHref,linkLabel}=Astro.props;
---
<div class="heading"><div>{eyebrow&&<p class="eyebrow">{eyebrow}</p>}<h2>{title}</h2>{description&&<p class="lede">{description}</p>}</div>{linkHref&&linkLabel&&<a class="text-link text-link--internal" href={linkHref}>{linkLabel}</a>}</div>
<style>.heading{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:clamp(2rem,4vw,3.5rem)}.heading .lede{margin-top:1rem;max-width:680px;font-size:clamp(1.05rem,1.7vw,1.35rem)}.heading>a{flex:none}@media(max-width:650px){.heading{align-items:start;flex-direction:column}}</style>
