---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const nav = site.nav;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Timothy Maxon, home"><span class="brand-mark" aria-hidden="true">TM</span><span>Timothy Maxon</span></a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-nav" data-menu-button><span>Menu</span><span class="menu-icon" aria-hidden="true"></span></button>
    <nav id="primary-nav" class="nav" aria-label="Primary navigation" data-nav>
      {nav.map((item) => {
        const active = item.href === '/' ? pathname === '/' : pathname.startsWith(item.href);
        return <a href={item.href} aria-current={active ? 'page' : undefined}>{item.label}</a>;
      })}
      {site.notesEnabled && <a href="/notes/">Notes</a>}
      {site.campaignMode && <a href="/campaign/">Campaign</a>}
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector('[data-menu-button]');
  const nav = document.querySelector('[data-nav]');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    nav?.toggleAttribute('data-open', !open);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      button?.setAttribute('aria-expanded', 'false');
      nav?.removeAttribute('data-open');
      (button as HTMLElement | null)?.focus();
    }
  });
</script>

<style>
  .site-header{position:relative;z-index:50;border-bottom:1px solid var(--line);background:rgba(251,252,251,.88);backdrop-filter:blur(14px)}
  .header-inner{min-height:84px;display:flex;align-items:center;justify-content:space-between;gap:2rem}
  .brand{display:inline-flex;align-items:center;gap:.8rem;font-weight:750;text-decoration:none}
  .brand-mark{display:grid;place-items:center;width:38px;height:38px;color:var(--white);background:var(--blue);font-family:var(--serif);font-size:.82rem}
  .nav{display:flex;align-items:center;gap:clamp(.75rem,1.6vw,1.65rem)}
  .nav a{position:relative;color:var(--ink-soft);font-size:.84rem;font-weight:680;text-decoration:none}
  .nav a:hover,.nav a[aria-current=page]{color:var(--ink)}
  .nav a[aria-current=page]::after{content:'';position:absolute;left:0;right:0;bottom:-.55rem;height:2px;background:var(--bronze)}
  .menu-button{display:none;border:0;background:transparent;font-weight:700}
  .menu-icon{width:22px;height:10px;border-top:2px solid;border-bottom:2px solid}
  @media(max-width:930px){.header-inner{min-height:72px}.menu-button{display:flex;align-items:center;gap:.65rem;padding:.5rem}.nav{display:none;position:absolute;top:72px;left:0;right:0;padding:1rem var(--gutter) 1.5rem;flex-direction:column;align-items:stretch;gap:0;border-bottom:1px solid var(--line);background:var(--paper-raised);box-shadow:var(--shadow)}.nav[data-open]{display:flex}.nav a{padding:.8rem 0;font-size:1rem}.nav a[aria-current=page]::after{right:auto;bottom:.5rem;width:24px}}
</style>
