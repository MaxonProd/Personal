---
import ContentLayout from '../layouts/ContentLayout.astro';import VentureCard from '../components/VentureCard.astro';import {ventures} from '../data/ventures';
---
<ContentLayout title="Ventures" eyebrow="Built around real needs" description="I develop and support practical businesses built around identifiable customer needs, straightforward operations, and long-term growth."><section class="section"><div class="container"><div class="grid grid--3">{ventures.map(v=><VentureCard {...v}/>)}</div></div></section><section class="section operating"><div class="container operating-grid"><div><p class="eyebrow">Operating perspective</p><h2>Useful first. Durable next.</h2></div><div class="principles"><article><span>01</span><h3>Start with the need</h3><p>A clear customer problem is more valuable than an elaborate business story.</p></article><article><span>02</span><h3>Keep operations legible</h3><p>Straightforward systems make it easier to learn, improve, and remain accountable.</p></article><article><span>03</span><h3>Build for the long term</h3><p>Growth matters when it strengthens the underlying organization and the people it serves.</p></article></div></div></section></ContentLayout>
<style>.operating{border-top:1px solid var(--line);background:var(--paper-soft)}.operating-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,7vw,8rem)}.operating-grid h2{max-width:500px}.principles article{display:grid;grid-template-columns:2.5rem 1fr;padding:1.5rem 0;border-top:1px solid var(--line)}.principles article>*:not(span){grid-column:2}.principles span{color:var(--bronze-dark);font-size:.72rem;font-weight:700}.principles p{margin-top:.65rem;color:var(--ink-soft)}@media(max-width:750px){.operating-grid{grid-template-columns:1fr}}</style>
