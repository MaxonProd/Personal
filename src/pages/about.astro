---
import ContentLayout from '../layouts/ContentLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import { credentialGroups } from '../data/credentials';
import { availableProfessionalDocuments } from '../data/professionalDocuments';
import { currentAppointments } from '../data/cv';

const chapters = [
  {
    n: '01',
    title: 'Northern Michigan roots',
    copy: 'My connection to Michigan runs through the Upper Peninsula, Munising, Hubbard Lake, and Alpena County. The region’s distances, seasons, small communities, and working landscapes have shaped how I think about institutions: they matter most when they are useful, dependable, and close to the people they serve.'
  },
  {
    n: '02',
    title: 'Military and public service',
    copy: 'My professional foundation includes service in the United States Air Force and Michigan Air National Guard, followed by federal civilian human-resources work. Those settings taught me the value of clear processes, responsible stewardship, and the quiet administrative work that allows larger missions to succeed.'
  },
  {
    n: '03',
    title: 'Human resources',
    copy: 'I have worked across recruitment and staffing, workforce planning, employee relations, organizational processes, HR systems, and process improvement. I see human resources as both a people function and a systems discipline: good outcomes require attention to individual experience and organizational design.'
  },
  {
    n: '04',
    title: 'Education and teaching',
    copy: 'As a DBA candidate and business professor, I work at the point where practical experience meets structured inquiry. Teaching, mentoring, and applied research allow me to help students translate concepts into decisions they can use in real organizations.'
  },
  {
    n: '05',
    title: 'Entrepreneurship',
    copy: 'Maxon Products, Citadel Wireless, and Fullrange Supply grew from the same practical impulse: identify a real need, understand the operating system around it, and build carefully. Entrepreneurship is not separate from my other work; it is another way to test ideas and make them useful.'
  }
];
---

<ContentLayout title="A practical path through people, systems, and service." eyebrow="About Timothy" description="My work has moved across military and public service, human resources, higher education, research, and entrepreneurship. The settings differ, but the questions are consistent: What do people need to do good work? What makes an organization useful? How can an idea become something durable?">
  <section class="section">
    <div class="container story">
      {chapters.map((chapter) => (
        <article>
          <div>
            <span>{chapter.n}</span>
            <h2>{chapter.title}</h2>
          </div>
          <p>{chapter.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section appointments-section">
    <div class="container">
      <SectionHeading eyebrow="Current appointments" title="Roles across commercial work and business education." />
      <ul class="appointment-list">
        {currentAppointments.map((appointment) => (
          <li>
            <div>
              <strong>{appointment.title}</strong>
              <span>{appointment.organization}</span>
            </div>
            <span class="appointment-date">{'aboutDetail' in appointment ? appointment.aboutDetail : appointment.date}</span>
          </li>
        ))}
      </ul>
      <p class="appointment-note">For detailed responsibilities and employment history, view the <a href="/cv/">curriculum vitae</a>.</p>
    </div>
  </section>

  <section class="section credentials-section">
    <div class="container">
      <SectionHeading eyebrow="Professional profile" title="Credentials & Affiliations" />
      <div class="credential-grid">
        {credentialGroups.filter((group) => group.entries.length > 0).map((group) => (
          <section class="credential-group" aria-label={group.title}>
            <h3>{group.title}</h3>
            <ul>
              {group.entries.map((entry) => (
                <li>
                  {'href' in entry && typeof entry.href === 'string' ? <a href={entry.href}>{entry.title}</a> : <strong>{entry.title}</strong>}
                  {'detail' in entry && entry.detail && <span>{entry.detail}</span>}
                  {'abbreviation' in entry && entry.abbreviation && <span>{entry.abbreviation}</span>}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="section dark-panel">
    <div class="container interests">
      <SectionHeading eyebrow="Beyond the work" title="Place, curiosity, and the long view." />
      <div class="grid grid--3">
        <div>
          <h3><a href="/beyond/photography/">Photography</a></h3>
          <p>Returning to an early interest through northern landscapes, wildlife, night skies, and everyday places.</p>
        </div>
        <div>
          <h3>Technology & local business</h3>
          <p>Interested in the tools and operating models that can strengthen rural economies and small organizations.</p>
        </div>
        <div>
          <h3>History & public life</h3>
          <p>Drawn to the way institutions, policy, and local decisions shape communities over time.</p>
        </div>
      </div>
      <a class="text-link text-link--internal" href="/beyond/">Explore Beyond</a>
    </div>
  </section>

  {availableProfessionalDocuments.length > 0 && (
    <section class="section professional-documents">
      <div class="container documents-grid">
        <div>
          <p class="eyebrow">Professional Documents</p>
          <h2>More detail, when useful.</h2>
        </div>
        <div>
          <p class="lede">Additional information about my professional experience, academic work, qualifications, and teaching is available in my CV, which serves as both my résumé and academic curriculum vitae.</p>
          <ul>
            {availableProfessionalDocuments.map((document) => (
              <li><a href={document.href} type="application/pdf" target="_blank" rel="noopener noreferrer">{document.label}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="container closing">
      <h2>Continue the conversation.</h2>
      <div>
        <Button href="https://www.linkedin.com/in/timothymaxon/" external>View LinkedIn</Button>
        <Button href="/contact/" variant="ghost">Contact Timothy</Button>
      </div>
    </div>
  </section>
</ContentLayout>

<style>
  .story{max-width:980px}
  .story article{display:grid;grid-template-columns:1fr 1.25fr;gap:clamp(2rem,6vw,6rem);padding:clamp(3rem,6vw,5.5rem) 0;border-top:1px solid var(--line)}
  .story article:first-child{padding-top:0;border-top:0}
  .story span{color:var(--bronze-dark);font-size:.72rem;font-weight:750}
  .story h2{margin-top:1.5rem;font-size:clamp(2rem,4vw,3.5rem)}
  .story article>p{color:var(--ink-soft);font-size:clamp(1.05rem,1.5vw,1.2rem)}
  .appointments-section{background:var(--paper-soft)}
  .appointment-list{display:grid;grid-template-columns:1fr 1fr;gap:0 2rem;margin:0;padding:0;list-style:none;border-top:1px solid var(--line)}
  .appointment-list li{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid var(--line)}
  .appointment-list li>div{display:grid;gap:.25rem}
  .appointment-list strong{font-size:.9rem}
  .appointment-list li>div>span,.appointment-date{color:var(--ink-soft);font-size:.8rem}
  .appointment-date{flex:0 0 auto;text-align:right}
  .appointment-note{margin-top:1.2rem;color:var(--ink-soft);font-size:.88rem}
  .appointment-note a{font-weight:750}
  .credentials-section{border-block:1px solid var(--line);background:var(--paper-soft)}
  .credential-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--line);border:1px solid var(--line)}
  .credential-group{padding:clamp(1.35rem,2.5vw,2rem);background:var(--paper)}
  .credential-group h3{margin-bottom:1.2rem;font-size:1.05rem}
  .credential-group ul,.professional-documents ul{display:grid;gap:1rem;margin:0;padding:0;list-style:none}
  .credential-group li{display:grid;gap:.2rem}
  .credential-group li strong,.credential-group li a{font-size:.9rem;text-decoration:none}
  .credential-group li span{color:var(--ink-soft);font-size:.8rem}
  .documents-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:3rem;align-items:start}
  .documents-grid h2{font-size:clamp(1.8rem,3vw,2.8rem)}
  .documents-grid .lede{margin-bottom:1.25rem}
  .professional-documents li{padding-top:.8rem;border-top:1px solid var(--line)}
  .professional-documents a{font-weight:750;text-decoration:none}
  .interests .grid>div{padding-top:1.5rem;border-top:1px solid #515551}
  .interests h3{margin-bottom:1rem}
  .interests h3 a{text-decoration:none}
  .interests p{color:#bcc2bc}
  .interests .text-link{margin-top:2rem;color:#eef6f8}
  .closing{display:flex;align-items:center;justify-content:space-between;gap:2rem}
  .closing>div{display:flex;flex-wrap:wrap;gap:.75rem}
  @media(max-width:720px){.story article{grid-template-columns:1fr}.closing{align-items:start;flex-direction:column}.documents-grid{grid-template-columns:1fr}.appointment-list{grid-template-columns:1fr}}
  @media(max-width:480px){.appointment-list li{align-items:flex-start;flex-direction:column}.appointment-date{text-align:left}}
  @media(max-width:560px){.credential-grid{grid-template-columns:1fr}}
</style>
