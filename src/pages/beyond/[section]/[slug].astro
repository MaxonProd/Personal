---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const sectionForCategory = {
    Restoration: 'historical-arms',
    History: 'historical-arms',
    Workshop: 'practical-projects',
    Technology: 'practical-projects',
    Outdoors: 'outdoors'
  } as const;
  const projects = await getCollection('beyondProjects', ({ data }) => !data.draft);
  return projects.map((project) => ({
    params: { section: sectionForCategory[project.data.category], slug: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const imageProps = (image: (typeof project.data.galleryImages)[number]) => ({
  src: image.src,
  srcset: image.srcset,
  sizes: image.sizes,
  alt: image.alt,
  caption: image.caption
});
---

<BaseLayout title={project.data.title} description={project.data.description}>
  <article>
    <header class="project-hero">
      <div class="container">
        <nav aria-label="Breadcrumb" class="breadcrumbs">
          <a href="/beyond/">Beyond</a><span aria-hidden="true">/</span>
          <a href={`/beyond/${Astro.params.section}/`}>{Astro.params.section === 'historical-arms' ? 'Historical Firearms & Restoration' : Astro.params.section === 'practical-projects' ? 'Making & Practical Projects' : 'Outdoors & Northern Michigan'}</a>
        </nav>
        <p class="eyebrow">{project.data.category}{project.data.date && ` / ${project.data.date.getFullYear()}`}</p>
        <div class:list={['hero-grid', !project.data.featuredImage && 'hero-grid--text']}>
          <div>
            <h1>{project.data.title}</h1>
            <p class="lede">{project.data.description}</p>
          </div>
          {project.data.featuredImage && (
            <figure class="feature-figure">
              <img src={project.data.featuredImage.src} srcset={project.data.featuredImage.srcset} sizes={project.data.featuredImage.sizes} alt={project.data.featuredImage.alt} loading="eager" decoding="async" />
              {project.data.featuredImage.caption && <figcaption>{project.data.featuredImage.caption}</figcaption>}
            </figure>
          )}
        </div>
      </div>
    </header>

    {(project.data.beforeImage || project.data.afterImage) && (
      <section class="container comparison" aria-label="Before and after images">
        {project.data.beforeImage && <figure><img src={imageProps(project.data.beforeImage).src} srcset={imageProps(project.data.beforeImage).srcset} sizes={imageProps(project.data.beforeImage).sizes} alt={imageProps(project.data.beforeImage).alt} /><figcaption>{project.data.beforeImage.caption ?? 'Before'}</figcaption></figure>}
        {project.data.afterImage && <figure><img src={imageProps(project.data.afterImage).src} srcset={imageProps(project.data.afterImage).srcset} sizes={imageProps(project.data.afterImage).sizes} alt={imageProps(project.data.afterImage).alt} /><figcaption>{project.data.afterImage.caption ?? 'After'}</figcaption></figure>}
      </section>
    )}

    <div class="container body-grid">
      <aside>
        <p class="eyebrow">Project details</p>
        {project.data.status && <p><strong>Status</strong><br />{project.data.status}</p>}
        {project.data.date && <p><strong>Date</strong><br />{project.data.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>}
        {project.data.location && <p><strong>Location</strong><br />{project.data.location}</p>}
        {project.data.tags.length > 0 && <div class="tags">{project.data.tags.map((tag) => <span>{tag}</span>)}</div>}
      </aside>
      <div class="prose"><Content /></div>
    </div>

    {project.data.galleryImages.length > 0 && (
      <section class="container gallery" aria-label="Project gallery">
        {project.data.galleryImages.map((image) => <figure><img src={image.src} srcset={image.srcset} sizes={image.sizes} alt={image.alt} loading="lazy" decoding="async" />{image.caption && <figcaption>{image.caption}</figcaption>}</figure>)}
      </section>
    )}
    <div class="container back-link"><a href={`/beyond/${Astro.params.section}/`}>← Back to projects</a></div>
  </article>
</BaseLayout>

<style>
  .project-hero{padding-block:clamp(3.5rem,7vw,6.5rem);border-bottom:1px solid var(--line);background:var(--paper-raised)}
  .breadcrumbs{display:flex;gap:.6rem;margin-bottom:2rem;color:var(--ink-soft);font-size:.8rem}
  .breadcrumbs a{color:inherit;text-decoration:none}
  .breadcrumbs a:hover{color:var(--ink);text-decoration:underline}
  .hero-grid{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(2.5rem,7vw,7rem);align-items:center}
  .hero-grid--text{grid-template-columns:minmax(0,850px)}
  h1{max-width:15ch;font-size:clamp(3rem,7vw,6.5rem)}
  .lede{max-width:46rem;margin-top:1.5rem}
  .feature-figure{margin:0;border:0;background:var(--paper-soft);box-shadow:var(--shadow)}
  .feature-figure img{width:100%;height:min(70vh,620px);object-fit:contain;background:var(--paper-soft)}
  .body-grid{display:grid;grid-template-columns:200px minmax(0,740px);gap:clamp(2.5rem,8vw,8rem);padding-block:var(--section)}
  aside p+p{margin-top:1.2rem}
  aside strong{font-size:.75rem;letter-spacing:.07em;text-transform:uppercase}
  .tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.5rem}
  .tags span{padding:.3rem .55rem;border:1px solid var(--line);font-size:.68rem}
  .prose :global(ul){padding-left:1.2rem}
  .comparison,.gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding-top:var(--section)}
  figure{margin:0;border:1px solid var(--line);background:var(--paper-raised)}
  figure img{width:100%;height:clamp(260px,38vw,480px);object-fit:cover}
  .comparison figure img,.gallery figure img{object-fit:contain;background:var(--paper-soft)}
  .gallery figure img{height:auto;max-height:560px}
  figcaption{padding:.75rem 1rem;color:var(--ink-soft);font-size:.85rem}
  .back-link{padding-block:0 var(--section)}
  .back-link a{font-size:.85rem;font-weight:750;text-decoration:none}
  @media(max-width:760px){.hero-grid,.body-grid{grid-template-columns:1fr}.feature-figure img{height:min(70vh,520px)}.comparison,.gallery{grid-template-columns:1fr}}
</style>
