---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import { getCollection, render } from 'astro:content';
import { academicAppointments } from '../../data/credentials';
import { site } from '../../data/site';
import VideoClip from '../../components/VideoClip.astro';

export async function getStaticPaths() {
  const items = await getCollection('work', ({ data }) => !data.draft);
  return items.map((item) => ({ params: { slug: item.id }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const { bookDetails, downloadUrl, summary, description } = item.data;
const pageDescription = bookDetails ? description : summary ?? description;
const year = bookDetails?.year ?? item.data.date?.getFullYear();
const printEditions = [
  { label: 'Amazon Paperback', format: 'Paperback', ...bookDetails?.paperback },
  { label: 'Amazon Hardcover', format: 'Hardcover', ...bookDetails?.hardcover }
].filter((edition): edition is typeof edition & { url: string } => Boolean(edition.url));
const teachingAppointments = item.data.category === 'Teaching' ? academicAppointments : [];
const schemaType = item.data.structuredDataType ?? (item.data.category === 'Books' ? 'Book' : 'CreativeWork');
const schema = {
  '@context': 'https://schema.org',
  '@type': schemaType,
  name: item.data.title,
  description: pageDescription,
  image: item.data.image ? new URL(item.data.image, site.domain).href : undefined,
  ...(item.data.date ? { datePublished: item.data.date.toISOString() } : {}),
  url: new URL(Astro.url.pathname, site.domain).href,
  ...(bookDetails ? {
    alternativeHeadline: bookDetails.subtitle,
    editor: { '@type': 'Person', name: bookDetails.editor },
    creditText: bookDetails.credit,
    isBasedOn: { '@type': 'Book', name: bookDetails.source },
    genre: bookDetails.genre,
    inLanguage: 'en',
    numberOfPages: bookDetails.pdfPages,
    ...(downloadUrl ? {
      bookEdition: `${bookDetails.year} digital edition`,
      bookFormat: 'https://schema.org/EBook',
      isAccessibleForFree: true,
      encoding: {
        '@type': 'MediaObject',
        encodingFormat: 'application/pdf',
        contentUrl: new URL(downloadUrl, site.domain).href
      }
    } : {}),
    ...(printEditions.length ? {
      workExample: printEditions.map((edition) => ({
        '@type': 'Book',
        name: item.data.title,
        bookFormat: `https://schema.org/${edition.format}`,
        url: edition.url,
        ...(edition.isbn ? { isbn: edition.isbn } : {})
      }))
    } : {})
  } : { author: { '@type': 'Person', name: site.name } })
};
---

<BaseLayout
  title={item.data.title}
  pageTitle={bookDetails ? `${item.data.title} | ${site.name}` : undefined}
  description={pageDescription}
  image={bookDetails ? item.data.image : undefined}
  type={schemaType === 'Book' ? 'book' : schemaType === 'Article' ? 'article' : 'website'}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article>
    <header class="work-hero">
      <div class="container hero-grid">
        <div>
          <p class="eyebrow">{item.data.category}{year && ` / ${year}`}</p>
          <h1>{item.data.title}</h1>
          <p class="lede">{bookDetails?.subtitle ?? summary ?? description}</p>
          {bookDetails && <p class="editorial-credit">{bookDetails.credit}</p>}
          <div class="actions">
            {bookDetails && downloadUrl ? (
              <>
                <Button href={downloadUrl} external>Read Free PDF</Button>
                <Button href={downloadUrl} variant="secondary" download>Download Free PDF</Button>
              </>
            ) : (
              <>
                {item.data.externalUrl && <Button href={item.data.externalUrl} external>View publication</Button>}
                {downloadUrl && <a class="download-link" href={downloadUrl} target="_blank" rel="noopener noreferrer">Open downloadable attachment</a>}
              </>
            )}
            <Button href="/work/" variant="ghost">Back to work</Button>
          </div>
          {printEditions.length > 0 && (
            <section class="print-editions" aria-labelledby="print-editions-heading">
              <h2 id="print-editions-heading">Prefer a printed copy?</h2>
              <ul>
                {printEditions.map((edition) => (
                  <li><Button href={edition.url} variant="secondary" external>{edition.label}</Button></li>
                ))}
              </ul>
            </section>
          )}
        </div>
        {
          item.data.image
            ? <img
                class:list={['book-cover', 'book-cover--image', bookDetails && 'book-cover--edition']}
                src={item.data.image}
                alt={`Cover of ${item.data.title}`}
                width={bookDetails?.cover.width}
                height={bookDetails?.cover.height}
                loading="eager"
                decoding="async"
              />
            : <div class="book-cover" aria-label={`Cover treatment for ${item.data.title}`}><span>{item.data.category}</span><strong>{item.data.coverTitle ?? item.data.title}</strong><i></i><small>Timothy Maxon</small></div>
        }
      </div>
    </header>
    <div class="container body-grid">
      <aside>
        <p class="eyebrow">Details</p>
        {item.data.organization && <p><strong>{item.data.category === 'Books' ? 'Publisher' : 'Institution or organization'}</strong><br />{item.data.organization}</p>}
        {item.data.date && <p><strong>{item.data.category === 'Books' || item.data.category === 'Writing' ? 'Published' : 'Date'}</strong><br />{item.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</p>}
        {bookDetails && (
          <>
            <p><strong>Genre</strong><br />{bookDetails.genre}</p>
            {downloadUrl && <p><strong>Digital edition</strong><br />Free PDF · {bookDetails.pdfPages} pages, including the cover</p>}
            {printEditions.length === 0 && <p><strong>Print editions</strong><br />Paperback and hardcover forthcoming</p>}
          </>
        )}
        {item.data.researchStatus && <p><strong>Research status</strong><br />{item.data.researchStatus}</p>}
        {teachingAppointments.length > 0 && (
          <div class="appointments">
            <p><strong>Academic appointments</strong></p>
            <ul>{teachingAppointments.map((appointment) => <li>{appointment.title}<br /><span>{appointment.institution}</span></li>)}</ul>
          </div>
        )}
        <div class="tags">{item.data.tags.map((tag) => <span>{tag}</span>)}</div>
        {item.data.citation && <p class="citation"><strong>Citation</strong><br />{item.data.citation}</p>}
      </aside>
      <div class="prose">
        <Content />
        {item.data.videoClips.map((clip, index) => <VideoClip {...clip} index={index} />)}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .work-hero{padding-block:clamp(4rem,8vw,7rem);border-bottom:1px solid var(--line)}
  .hero-grid{display:grid;grid-template-columns:1.25fr minmax(220px,.45fr);gap:clamp(3rem,8vw,8rem);align-items:center}
  .work-hero h1{font-size:clamp(3rem,6vw,6rem)}
  .work-hero .lede{margin-top:1.5rem}
  .actions{display:flex;flex-wrap:wrap;gap:.75rem;margin-top:2rem}
  .editorial-credit{margin-top:.8rem;color:var(--ink-soft);font-weight:700}
  .print-editions{margin-top:1.7rem}
  .print-editions h2{font-size:1.2rem}
  .print-editions ul{display:flex;flex-wrap:wrap;gap:.75rem;margin:.7rem 0 0;padding:0;list-style:none}
  .download-link{align-self:center;color:var(--ink);font-size:.85rem;font-weight:750}
  .book-cover{aspect-ratio:3/4;display:flex;padding:2rem;flex-direction:column;color:#eef6f8;background:linear-gradient(155deg,#244c65,#152633);box-shadow:0 20px 45px rgba(24,35,45,.25)}
  .book-cover--image{width:min(100%,340px);height:auto;justify-self:end;padding:0;object-fit:cover}
  .book-cover--edition{aspect-ratio:auto}
  .book-cover>span{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase}
  .book-cover strong{width:100%;min-width:0;margin:auto 0;font-family:var(--serif);font-size:clamp(1.35rem,2.2vw,2rem);font-weight:500;line-height:1.03;overflow-wrap:normal;word-break:normal;hyphens:manual}
  .book-cover i{width:44px;height:2px;margin-bottom:1rem;background:#8cc7d3}
  .book-cover small{text-transform:uppercase;letter-spacing:.08em}
  .body-grid{display:grid;grid-template-columns:220px minmax(0,740px);gap:clamp(3rem,8vw,8rem);padding-block:var(--section)}
  aside p+p{margin-top:1.2rem}
  .citation{overflow-wrap:anywhere;color:var(--ink-soft);font-size:.82rem}
  .appointments ul{display:grid;gap:.8rem;margin:0;padding:0;list-style:none}
  .appointments li{font-size:.85rem}
  .appointments li span{color:var(--ink-soft)}
  aside strong{font-size:.75rem;text-transform:uppercase;letter-spacing:.07em}
  .tags{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.5rem}
  .tags span{padding:.3rem .55rem;border:1px solid var(--line);font-size:.68rem}
  .prose :global(ul){padding-left:1.2rem}
  @media(max-width:760px){.hero-grid,.body-grid{grid-template-columns:1fr}.book-cover--image{justify-self:start;max-width:300px}}
</style>
