---
import ContentLayout from '../layouts/ContentLayout.astro';
---

<ContentLayout title="Privacy" eyebrow="Site information" description="A short, plain-language description of how this website handles data.">
  <section class="section">
    <div class="container prose">
      <h2>Contact messages</h2>
      <p>The contact form opens your default email app and prepares a message addressed to Office Hours. The message is not submitted to this website before you send it from your own email app. Do not send sensitive personal information through the form.</p>

      <h2>Analytics</h2>
      <p>This site is prepared to use Cloudflare Web Analytics, a privacy-conscious service intended to provide aggregate information about site use without cross-site tracking.</p>

      <h2>External links</h2>
      <p>Links to LinkedIn, Office Hours, publications, and venture websites lead to services with their own privacy practices.</p>

      <h2>Questions</h2>
      <p>Use the <a href="/contact/">contact page</a> for questions about this website.</p>
    </div>
  </section>
</ContentLayout>
